<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>FlowBreaker by ghostapps</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior-y: none;
        }

        .bg-animated {
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        .soft-shadow {
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }

        .button-pop {
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        
        .button-pop:active {
            transform: scale(0.92);
        }

        .fade-in {
            animation: fadeIn 0.3s ease-out forwards;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .shake {
            animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
        }
        
        @keyframes shake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }

        .no-select {
            -webkit-user-select: none;
            user-select: none;
        }

        .pb-safe {
            padding-bottom: env(safe-area-inset-bottom, 20px);
        }
    </style>
</head>
<body class="text-gray-900 h-[100dvh] flex flex-col overflow-hidden bg-animated">

    <!-- Header -->
    <header class="pt-14 pb-4 px-6 glass text-center flex-shrink-0 z-20 relative">
        <button id="btn-back" class="hidden absolute left-4 bottom-4 text-gray-500 hover:text-gray-900 p-2 button-pop rounded-full bg-white/50">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <h1 class="text-2xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-pink-500">FlowBreaker</h1>
        <p class="text-[10px] text-gray-500 mt-0.5 font-bold tracking-widest uppercase">by ghostapps 👻</p>
    </header>

    <!-- MENU SCREEN -->
    <main id="screen-menu" class="flex-1 px-6 pt-8 pb-safe overflow-y-auto w-full max-w-lg mx-auto flex flex-col gap-6">
        <h2 class="text-white text-3xl font-black text-center mb-2 drop-shadow-md">Choose a Deck</h2>
        <div id="deck-container" class="flex flex-col gap-4"></div>
    </main>

    <!-- LESSON SCREEN -->
    <main id="screen-lesson" class="hidden flex-1 px-4 flex flex-col w-full max-w-lg mx-auto relative z-10">
        
        <div class="py-4 flex justify-center flex-shrink-0">
            <div class="bg-white/40 backdrop-blur-md rounded-full p-1.5 flex w-full max-w-sm relative shadow-sm border border-white/50">
                <button id="tab-build" class="flex-1 text-sm font-bold py-2.5 rounded-full bg-white text-purple-600 shadow-md transition-all no-select button-pop">Deconstruct</button>
                <button id="tab-speak" class="flex-1 text-sm font-bold py-2.5 rounded-full text-gray-500 transition-all no-select button-pop">Speak</button>
            </div>
        </div>

        <div class="text-center text-sm text-white/90 font-bold mb-4 tracking-wider uppercase drop-shadow-sm" id="progress-text">Phrase 1 of X</div>

        <!-- Flashcard -->
        <div class="bg-white/95 backdrop-blur-xl rounded-[2rem] soft-shadow p-6 mb-4 flex-1 flex flex-col min-h-0 border border-white/50">
            <h2 class="text-2xl font-extrabold text-center mb-6 text-gray-800 flex-shrink-0 leading-tight" id="english-text">Target English Phrase</h2>

            <!-- Build Mode Area -->
            <div id="build-mode-area" class="flex flex-col flex-1 overflow-y-auto">
                <div id="dropzone" class="flex flex-wrap gap-2 min-h-[90px] p-5 bg-gray-50/50 rounded-2xl border-2 border-dashed border-purple-200 mb-6 content-start transition-all duration-300 items-center justify-center flex-shrink-0">
                    <span id="dropzone-placeholder" class="text-purple-300 text-sm font-bold uppercase tracking-wider">Tap words below</span>
                </div>
                <div class="flex-1"></div>
                <div id="word-bank" class="flex flex-wrap gap-3 justify-center mt-auto pb-2 flex-shrink-0"></div>
            </div>

            <!-- Speak Mode Area -->
            <div id="speak-mode-area" class="hidden flex-col flex-1 items-center justify-center">
                <button id="reveal-btn" class="bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-bold py-5 px-10 rounded-2xl text-xl w-full button-pop soft-shadow no-select">
                    Reveal Answer
                </button>
                <div id="revealed-container" class="hidden flex-col items-center justify-center mt-8 mb-4 w-full px-4">
                    <div id="revealed-text" class="text-3xl font-extrabold text-center bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-indigo-600 text-balance mb-4"></div>
                    <!-- Audio Replay Button for Speak Mode -->
                    <button id="speak-replay-btn" class="bg-purple-100 text-purple-600 hover:bg-purple-200 rounded-full p-4 button-pop transition-colors shadow-sm">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5 10v4a2 2 0 002 2h2.586l3.707 3.707A1 1 0 0015 19V5a1 1 0 00-1.707-.707L9.586 8H7a2 2 0 00-2 2z"></path></svg>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer Action Area -->
    <div id="footer-action" class="hidden px-4 pt-2 pb-safe w-full max-w-lg mx-auto flex-shrink-0 z-20">
        <button id="next-btn" class="hidden w-full bg-gradient-to-r from-gray-800 to-black text-white font-black py-4.5 rounded-2xl text-xl button-pop no-select soft-shadow mb-2 h-16">
            Next Phrase →
        </button>
        <div id="next-btn-spacer" class="w-full h-16 mb-2"></div>
    </div>

    <script>
        const decksData = {
            basics: {
                title: "The Basics",
                color: "from-pink-500 to-rose-400",
                icon: "👋",
                phrases: [
                    { en: "I am going to the store.", bg: "Отивам до магазина." },
                    { en: "How are you doing today?", bg: "Как си днес?" },
                    { en: "I don't understand you.", bg: "Не те разбирам." },
                    { en: "What time is it?", bg: "Колко е часът?" },
                    { en: "Can you help me?", bg: "Можеш ли да ми помогнеш?" },
                    { en: "It is very nice to meet you.", bg: "Много ми е приятно да се запознаем." },
                    { en: "What are you doing this weekend?", bg: "Какво ще правиш този уикенд?" },
                    { en: "I am tired and want to sleep.", bg: "Уморен съм и искам да спя." },
                    { en: "Excuse me.", bg: "Извинете ме." },
                    { en: "Thank you very much.", bg: "Много благодаря." },
                    { en: "Have a good day!", bg: "Приятен ден!" },
                    { en: "I am sorry.", bg: "Съжалявам." },
                    { en: "See you later.", bg: "Ще се видим по-късно." },
                    { en: "What is your name?", bg: "Как се казваш?" },
                    { en: "My name is Scott.", bg: "Казвам се Скот." }
                ]
            },
            dining: {
                title: "Dining & Food",
                color: "from-amber-400 to-orange-500",
                icon: "🍷",
                phrases: [
                    { en: "I want a coffee, please.", bg: "Искам едно кафе, моля." },
                    { en: "Where is the best restaurant?", bg: "Къде е най-добрият ресторант?" },
                    { en: "I would like a table for two.", bg: "Бих желал маса за двама." },
                    { en: "Could I have the bill, please?", bg: "Може ли сметката, моля?" },
                    { en: "The food is delicious.", bg: "Храната е много вкусна." }
                ]
            },
            travel: {
                title: "Travel & Logistics",
                color: "from-emerald-400 to-teal-500",
                icon: "✈️",
                phrases: [
                    { en: "Where is the bathroom?", bg: "Къде е тоалетната?" },
                    { en: "How much does this cost?", bg: "Колко струва това?" },
                    { en: "Do you speak English?", bg: "Говорите ли английски?" },
                    { en: "I need a doctor.", bg: "Имам нужда от лекар." },
                    { en: "I am looking for the train station.", bg: "Търся гарата." },
                    { en: "I love this city.", bg: "Обичам този град." },
                    { en: "Can I pay with a card?", bg: "Мога ли да платя с карта?" },
                    { en: "I need a taxi.", bg: "Трябва ми такси." },
                    { en: "Where are we going?", bg: "Накъде отиваме?" },
                    { en: "This is beautiful.", bg: "Това е красиво." }
                ]
            }
        };

        let activeDeck = null;
        let currentMode = 'build'; 
        let currentIndex = 0;
        let wordObjects = []; 
        let selectedIds = []; 

        const elScreenMenu = document.getElementById('screen-menu');
        const elScreenLesson = document.getElementById('screen-lesson');
        const elFooterAction = document.getElementById('footer-action');
        const elDeckContainer = document.getElementById('deck-container');
        const elBtnBack = document.getElementById('btn-back');
        
        const elTabBuild = document.getElementById('tab-build');
        const elTabSpeak = document.getElementById('tab-speak');
        const elProgress = document.getElementById('progress-text');
        const elEnglish = document.getElementById('english-text');
        const elBuildArea = document.getElementById('build-mode-area');
        const elSpeakArea = document.getElementById('speak-mode-area');
        const elDropzone = document.getElementById('dropzone');
        const elWordBank = document.getElementById('word-bank');
        const elRevealBtn = document.getElementById('reveal-btn');
        const elRevealedContainer = document.getElementById('revealed-container');
        const elRevealedText = document.getElementById('revealed-text');
        const elSpeakReplayBtn = document.getElementById('speak-replay-btn');
        const elNextBtn = document.getElementById('next-btn');
        const elNextBtnSpacer = document.getElementById('next-btn-spacer');

        function init() {
            renderMenu();
            setupEventListeners();
        }

        // TEXT TO SPEECH FUNCTION
        function speakBulgarian(text) {
            if ('speechSynthesis' in window) {
                // Cancel any currently playing speech so they don't queue up if tapped fast
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'bg-BG';
                utterance.rate = 0.85; // Slightly slower for language learners
                window.speechSynthesis.speak(utterance);
            }
        }

        function renderMenu() {
            elDeckContainer.innerHTML = '';
            for (const [key, deck] of Object.entries(decksData)) {
                const card = document.createElement('button');
                card.className = `w-full bg-white rounded-3xl p-6 soft-shadow button-pop text-left relative overflow-hidden group border-2 border-transparent hover:border-white/50`;
                card.innerHTML = `
                    <div class="absolute inset-0 bg-gradient-to-br ${deck.color} opacity-10 group-hover:opacity-20 transition-opacity"></div>
                    <div class="flex items-center justify-between relative z-10">
                        <div>
                            <span class="text-4xl mb-3 block">${deck.icon}</span>
                            <h3 class="text-2xl font-black text-gray-800">${deck.title}</h3>
                            <p class="text-gray-500 font-bold mt-1">${deck.phrases.length} Phrases</p>
                        </div>
                        <div class="bg-gray-100 rounded-full p-3 text-gray-400">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path></svg>
                        </div>
                    </div>
                `;
                card.onclick = () => startDeck(key);
                elDeckContainer.appendChild(card);
            }
        }

        function startDeck(deckKey) {
            activeDeck = decksData[deckKey].phrases;
            currentIndex = 0;
            currentMode = 'build';
            
            elScreenMenu.classList.add('hidden');
            elScreenLesson.classList.remove('hidden');
            elFooterAction.classList.remove('hidden');
            elBtnBack.classList.remove('hidden');
            
            updateTabUI();
            loadPhrase();
        }

        function returnToMenu() {
            elScreenLesson.classList.add('hidden');
            elFooterAction.classList.add('hidden');
            elBtnBack.classList.add('hidden');
            elScreenMenu.classList.remove('hidden');
            window.speechSynthesis.cancel(); // Stop audio if user leaves mid-sentence
            activeDeck = null;
        }

        function setupEventListeners() {
            elTabBuild.addEventListener('click', () => { currentMode = 'build'; updateTabUI(); loadPhrase(); });
            elTabSpeak.addEventListener('click', () => { currentMode = 'speak'; updateTabUI(); loadPhrase(); });
            elNextBtn.addEventListener('click', nextPhrase);
            elRevealBtn.addEventListener('click', revealAnswer);
            elBtnBack.addEventListener('click', returnToMenu);
            
            // Replay button for Speak Mode
            elSpeakReplayBtn.addEventListener('click', () => {
                if (activeDeck) speakBulgarian(activeDeck[currentIndex].bg);
            });

            elDropzone.addEventListener('animationend', () => {
                elDropzone.classList.remove('shake');
            });
        }

        function updateTabUI() {
            if (currentMode === 'build') {
                elTabBuild.className = "flex-1 text-sm font-bold py-2.5 rounded-full bg-white text-purple-600 shadow-md transition-all no-select button-pop";
                elTabSpeak.className = "flex-1 text-sm font-bold py-2.5 rounded-full text-gray-500 transition-all no-select button-pop";
                elBuildArea.classList.remove('hidden');
                elBuildArea.classList.add('flex');
                elSpeakArea.classList.add('hidden');
                elSpeakArea.classList.remove('flex');
            } else {
                elTabSpeak.className = "flex-1 text-sm font-bold py-2.5 rounded-full bg-white text-purple-600 shadow-md transition-all no-select button-pop";
                elTabBuild.className = "flex-1 text-sm font-bold py-2.5 rounded-full text-gray-500 transition-all no-select button-pop";
                elBuildArea.classList.add('hidden');
                elBuildArea.classList.remove('flex');
                elSpeakArea.classList.remove('hidden');
                elSpeakArea.classList.add('flex');
            }
        }

        function nextPhrase() {
            window.speechSynthesis.cancel(); // Stop audio before moving to next
            currentIndex = (currentIndex + 1) % activeDeck.length;
            loadPhrase();
        }

        function loadPhrase() {
            const phrase = activeDeck[currentIndex];
            elProgress.textContent = `Phrase ${currentIndex + 1} of ${activeDeck.length}`;
            elEnglish.textContent = phrase.en;
            
            elNextBtn.classList.add('hidden');
            elNextBtnSpacer.classList.remove('hidden');

            if (currentMode === 'build') {
                resetBuildMode(phrase.bg);
            } else {
                resetSpeakMode();
            }
        }

        function normalizeText(text) {
            return text.toLowerCase().replace(/[.,?!]/g, '').trim();
        }

        function getWords(text) {
            return normalizeText(text).split(/\s+/);
        }

        function resetBuildMode(bgText) {
            const words = getWords(bgText);
            wordObjects = shuffleArray([...words]).map((w, i) => ({ id: i, text: w, used: false }));
            selectedIds = [];
            
            elDropzone.className = "flex flex-wrap gap-2 min-h-[90px] p-5 bg-gray-50/50 rounded-2xl border-2 border-dashed border-purple-200 mb-6 content-start transition-all duration-300 items-center justify-center flex-shrink-0";
            elDropzone.style.pointerEvents = "auto";
            
            renderBuildUI();
        }

        function renderBuildUI() {
            elDropzone.innerHTML = '';
            elWordBank.innerHTML = '';

            if (selectedIds.length === 0) {
                elDropzone.innerHTML = `<span class="text-purple-300 text-sm font-bold uppercase tracking-wider">Tap words below</span>`;
            } else {
                selectedIds.forEach(id => {
                    const wordObj = wordObjects.find(w => w.id === id);
                    const btn = createWordButton(wordObj.text, true);
                    btn.onclick = () => handleDeselect(id);
                    elDropzone.appendChild(btn);
                });
            }

            wordObjects.forEach(wordObj => {
                const btn = createWordButton(wordObj.text, false);
                if (wordObj.used) {
                    btn.classList.add('opacity-0', 'pointer-events-none');
                } else {
                    btn.onclick = () => {
                        // Play audio of the single word when tapped
                        speakBulgarian(wordObj.text); 
                        handleSelect(wordObj.id);
                    };
                }
                elWordBank.appendChild(btn);
            });
        }

        function createWordButton(text, isSelected) {
            const btn = document.createElement('button');
            btn.textContent = text;
            btn.className = `px-5 py-3 rounded-2xl font-bold text-lg button-pop no-select ${
                isSelected 
                ? 'bg-gradient-to-r from-purple-500 to-indigo-500 text-white shadow-md' 
                : 'bg-white text-gray-700 border-2 border-gray-100 shadow-sm hover:border-purple-200'
            }`;
            return btn;
        }

        function handleSelect(id) {
            elDropzone.classList.remove('border-red-400', 'bg-red-50');
            elDropzone.classList.add('border-purple-200', 'bg-gray-50/50');

            const wordObj = wordObjects.find(w => w.id === id);
            wordObj.used = true;
            selectedIds.push(id);
            renderBuildUI();

            if (selectedIds.length === wordObjects.length) {
                checkAnswer();
            }
        }

        function handleDeselect(id) {
            elDropzone.classList.remove('border-red-400', 'bg-red-50');
            elDropzone.classList.add('border-purple-200', 'bg-gray-50/50');

            const wordObj = wordObjects.find(w => w.id === id);
            wordObj.used = false;
            selectedIds = selectedIds.filter(selectedId => selectedId !== id);
            renderBuildUI();
        }

        function checkAnswer() {
            const currentAttempt = selectedIds.map(id => wordObjects.find(w => w.id === id).text).join(' ');
            const target = getWords(activeDeck[currentIndex].bg).join(' ');

            if (currentAttempt === target) {
                showBuildSuccess();
            } else {
                elDropzone.classList.remove('border-purple-200', 'bg-gray-50/50');
                elDropzone.classList.add('border-red-400', 'bg-red-50', 'shake');
                if (navigator.vibrate) navigator.vibrate(50);
            }
        }

        function showBuildSuccess() {
            const phrase = activeDeck[currentIndex];
            
            // Format the dropzone for success, adding a replay audio button alongside the text
            elDropzone.className = "flex flex-col gap-3 min-h-[90px] p-6 bg-gradient-to-r from-emerald-400 to-teal-500 rounded-2xl border-none mb-6 items-center justify-center transition-all duration-300 fade-in flex-shrink-0 soft-shadow";
            elDropzone.innerHTML = `
                <div class="flex items-center gap-2">
                    <div class="bg-white/20 rounded-full p-1">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-white text-2xl font-black text-center drop-shadow-sm">${phrase.bg}</span>
                    <button id="success-replay-btn" class="bg-white/20 hover:bg-white/30 text-white rounded-full p-2.5 button-pop transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5 10v4a2 2 0 002 2h2.586l3.707 3.707A1 1 0 0015 19V5a1 1 0 00-1.707-.707L9.586 8H7a2 2 0 00-2 2z"></path></svg>
                    </button>
                </div>
            `;
            // Keep dropzone interactive so the replay button works, but disable the background
            elDropzone.style.pointerEvents = "auto";
            
            // Wire up the new replay button
            document.getElementById('success-replay-btn').onclick = () => speakBulgarian(phrase.bg);
            
            elWordBank.innerHTML = '';
            
            elNextBtnSpacer.classList.add('hidden');
            elNextBtn.classList.remove('hidden');
            elNextBtn.classList.add('fade-in');

            // Play the full audio immediately
            speakBulgarian(phrase.bg);

            confetti({
                particleCount: 120,
                spread: 80,
                origin: { y: 0.6 },
                colors: ['#e73c7e', '#23a6d5', '#34C759', '#f59e0b', '#8b5cf6'],
                disableForReducedMotion: true,
                zIndex: 100
            });
        }

        function resetSpeakMode() {
            elRevealBtn.classList.remove('hidden');
            elRevealedContainer.classList.add('hidden');
            elRevealedContainer.classList.remove('fade-in');
        }

        function revealAnswer() {
            elRevealBtn.classList.add('hidden');
            
            const phrase = activeDeck[currentIndex];
            elRevealedText.textContent = phrase.bg;
            
            elRevealedContainer.classList.remove('hidden');
            elRevealedContainer.classList.add('flex', 'fade-in');
            
            elNextBtnSpacer.classList.add('hidden');
            elNextBtn.classList.remove('hidden');
            elNextBtn.classList.add('fade-in');

            // Play the full audio immediately upon reveal
            speakBulgarian(phrase.bg);
        }

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        init();
    </script>
</body>
</html>
